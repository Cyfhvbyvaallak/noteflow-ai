# NoteFlow AI - Environment Configuration Example

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & JWT Auth
SECRET_KEY=noteflow_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / MySQL / SQLite)
# Supabase Cloud Database example:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local MySQL example:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/noteflow_ai
DATABASE_URL=postgresql://postgres.your_supabase_ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# If cloud connection fails or is omitted, backend automatically falls back to local SQLite for smooth zero-configuration run.
SQLITE_FALLBACK=true

# AI Services (OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text Configuration
# Options: openai_whisper, speech_recognition, demo
STT_PROVIDER=openai_whisper

# Upload Settings
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
